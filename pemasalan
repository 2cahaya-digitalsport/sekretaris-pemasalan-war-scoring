                <tr class="border-b border-slate-200 hover:bg-rose-50/50 transition-colors">
                    <td class="p-3 text-center text-xs font-black border-r border-slate-200 bg-slate-50/50">${start + i + 1}</td>
                    <td class="p-3 border-r border-slate-200">
                        <div class="flex items-center">
                            ${photoIcon}
                            <div class="overflow-hidden">
                                <div class="text-[11px] font-black text-slate-800 uppercase truncate">${p.nama}</div>
                                <div class="text-[9px] text-rose-600 font-bold tracking-tight uppercase truncate">${p.kont}</div>
                            </div>
                        </div>
                    </td>
                    <td class="p-3 text-center uppercase font-black text-slate-700 border-r border-slate-200 text-xs">${p.kelas}</td>
                    <td class="p-3 text-center uppercase border-r border-slate-200">
                        <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded text-[9px] font-black">${p.cat}</span>
                    </td>
                    <td class="p-3 text-center uppercase font-bold text-slate-500 text-[10px] border-r border-slate-200">${p.gender}</td>
                    <td class="p-3 text-center">
                        <div class="flex items-center justify-center gap-3">
                            <button onclick="editParticipantLoting(${p.id})" class="text-blue-500 hover:text-blue-700 active:scale-90 text-sm"><i class="fas fa-edit"></i></button>
                            <button onclick="deleteParticipantLoting(${p.id})" class="text-rose-500 hover:text-rose-700 active:scale-90 text-sm"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </td>
                </tr>`
            }).join('');
        }
    }

    // --- HELPER LOTING: SHUFFLE & ANTI KONTINGEN SAMA ---
    function shuffleArray(arr) {
        const a = [...arr];
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
    }

    function normKont(k) {
        return (k || "").toString().trim().toUpperCase();
    }

    function getPermutations(arr) {
        if (arr.length <= 1) return [arr];
        const result = [];
        for (let i = 0; i < arr.length; i++) {
            const current = arr[i];
            const remaining = arr.slice(0, i).concat(arr.slice(i + 1));
            for (const perm of getPermutations(remaining)) {
                result.push([current, ...perm]);
            }
        }
        return result;
    }

    // Pilih susunan acak terbaik di dalam 1 pool (maks 4 peserta) agar tidak mempertemukan kontingen yang sama
    function optimizePoolOrder(chunk) {
        if (chunk.length <= 1) return chunk;
        const perms = getPermutations(chunk);
        let bestScore = Infinity;
        let bestPerms = [];

        for (const p of perms) {
            let directClashes = 0;
            let bracketClashes = 0;

            if (p.length === 4) {
                if (normKont(p[0].kont) === normKont(p[1].kont)) directClashes++;
                if (normKont(p[2].kont) === normKont(p[3].kont)) directClashes++;
                // Jika ada kontingen sama di pool yg sama, usahakan beda sisi bagan (agar hanya bertemu jika keduanya menang ke final)
                if (normKont(p[0].kont) === normKont(p[2].kont)) bracketClashes++;
                if (normKont(p[0].kont) === normKont(p[3].kont)) bracketClashes++;
                if (normKont(p[1].kont) === normKont(p[2].kont)) bracketClashes++;
                if (normKont(p[1].kont) === normKont(p[3].kont)) bracketClashes++;
            } else if (p.length === 3) {
                // p[0] vs p[1] di Semi Final, p[2] mendapat Bye
                if (normKont(p[0].kont) === normKont(p[1].kont)) directClashes++;
                if (normKont(p[0].kont) === normKont(p[2].kont)) bracketClashes++;
                if (normKont(p[1].kont) === normKont(p[2].kont)) bracketClashes++;
            } else if (p.length === 2) {
                if (normKont(p[0].kont) === normKont(p[1].kont)) directClashes++;
            }

            const score = directClashes * 100 + bracketClashes;
            if (score < bestScore) {
                bestScore = score;
                bestPerms = [p];
            } else if (score === bestScore) {
                bestPerms.push(p);
            }
        }

        return bestPerms[Math.floor(Math.random() * bestPerms.length)];
    }

    // Sebar peserta ke dalam chunks (pool) dengan memisahkan kontingen yang sama ke pool berbeda
    function distributeParticipantsToChunks(pool, chunkSizes) {
        const chunks = chunkSizes.map(() => []);
        if (chunkSizes.length === 1) {
            chunks[0] = optimizePoolOrder(shuffleArray(pool));
            return chunks;
        }

        // Kelompokkan peserta berdasarkan kontingen
        const byKont = {};
        pool.forEach(p => {
            const k = normKont(p.kont);
            if (!byKont[k]) byKont[k] = [];
            byKont[k].push(p);
        });

        // Acak urutan dalam tiap kontingen, lalu urutkan kontingen dari jumlah anggota terbanyak
        const kontGroups = shuffleArray(Object.keys(byKont)).map(k => ({
            kont: k,
            members: shuffleArray(byKont[k])
        }));
        kontGroups.sort((a, b) => b.members.length - a.members.length);

        // Distribusikan anggota kontingen terbanyak lebih dulu ke pool yang paling sedikit memiliki kontingen tsb
        for (const group of kontGroups) {
            for (const participant of group.members) {
                let bestChunkIndices = [];
                let bestSameKontCount = Infinity;
                let bestFillRatio = Infinity;

                for (let idx = 0; idx < chunks.length; idx++) {
                    if (chunks[idx].length >= chunkSizes[idx]) continue;

                    const sameKontCount = chunks[idx].filter(x => normKont(x.kont) === group.kont).length;
                    const fillRatio = chunks[idx].length / chunkSizes[idx];

                    if (
                        sameKontCount < bestSameKontCount ||
                        (sameKontCount === bestSameKontCount && fillRatio < bestFillRatio - 1e-9)
                    ) {
                        bestSameKontCount = sameKontCount;
                        bestFillRatio = fillRatio;
                        bestChunkIndices = [idx];
                    } else if (sameKontCount === bestSameKontCount && Math.abs(fillRatio - bestFillRatio) <= 1e-9) {
                        bestChunkIndices.push(idx);
                    }
                }

                const chosenIdx = bestChunkIndices[Math.floor(Math.random() * bestChunkIndices.length)];
                chunks[chosenIdx].push(participant);
            }
        }

        return chunks.map(c => optimizePoolOrder(c));
    }

    // --- ALGORITMA LOTING PEMASALAN (Otomatis Max 4 Peserta Per Pool, Anti Kontingen Sama, Jeda Semi -> Final) --- 
    window.executeLoting = function(useFilter = false) {
        let list = window.state.participants || [];
        
        if (useFilter) {
            list = list.filter(p => 
                (window.lotingFilterCat === 'SEMUA' || p.cat === window.lotingFilterCat) && 
                (window.lotingFilterKelas === 'SEMUA' || p.kelas === window.lotingFilterKelas) && 
                (window.lotingFilterGender === 'SEMUA' || p.gender === window.lotingFilterGender)
            );
            if(list.length < 1) { 
                alert("Tidak ada peserta pada filter saat ini."); 
                return; 
            }
            if(!confirm("Peringatan: Jadwal bagan sebelumnya akan tetap disimpan. Loting ini HANYA akan membuat jadwal/pool baru untuk kategori yang difilter. Lanjutkan?")) return;
        } else {
            if(list.length < 1) { 
                alert("Harus ada peserta yang terdaftar untuk melakukan loting."); 
                return; 
            }
            if(!confirm("Peringatan: Loting pemasalan akan mereset jadwal yang sudah ada dan memecah SEMUA peserta ke dalam Pool maksimal 4 orang. Lanjutkan?")) return;
        }
        
        let existingMatches = (window.state.matches || []).filter(m => m && (m.m || m.b));
        let groupsToRegenerate = new Set();
        list.forEach(p => groupsToRegenerate.add(`${p.cat}|${p.kelas}|${p.gender}`));

        // Hilangkan match lama yang akan di-generate ulang
        if (useFilter) {
            existingMatches = existingMatches.filter(m => {
                let baseKelasM = m.kelas ? m.kelas.replace(/ POOL \d+$/, '') : '';
                return !groupsToRegenerate.has(`${m.cat}|${baseKelasM}|${m.gender}`);
            });
        } else {
            existingMatches = []; 
        }

        // 1. KELOMPOKKAN BERDASARKAN KATEGORI DASAR
        const groups = {};
        list.forEach(p => { 
            const key = `${p.cat}|${p.kelas}|${p.gender}`; 
            if(!groups[key]) groups[key] = []; 
            groups[key].push(p); 
        });
        
        const sortedGroupKeys = Object.keys(groups).sort((a,b) => groups[b].length - groups[a].length);
        
        let generatedMatches = [];
        let tempPIdx = 10000; 
        
        for(const k of sortedGroupKeys) {
            let pool = [...groups[k]];
            
            // --- PEMBAGIAN CHUNK/POOL UNTUK PEMASALAN (MAKS 4 PESERTA PER POOL) ---
            let chunkSizes = [];
            let rem = pool.length;
            while (rem > 0) {
                if (rem % 4 === 0) {
                    chunkSizes.push(4); rem -= 4;
                } else if (rem % 4 === 3) {
                    chunkSizes.push(3); rem -= 3;
                } else if (rem % 4 === 2) {
                    if (rem >= 6) {
                        chunkSizes.push(3); rem -= 3;
                    } else {
                        chunkSizes.push(2); rem -= 2;
                    }
                } else if (rem % 4 === 1) {
                    if (rem >= 5) {
                        chunkSizes.push(3); rem -= 3;
                    } else {
                        chunkSizes.push(1); rem -= 1;
                    }
                }
            }

            // Sebar peserta agar kontingen sama tidak berada di pool / partai yang sama (kecuali jika hanya 2 peserta)
            let chunks = distributeParticipantsToChunks(pool, chunkSizes);
            
            // --- GENERATE BRACKET UNTUK SETIAP POOL (Maks 4 Orang) ---
            chunks.forEach((chunk, chunkIdx) => {
                let poolSuffix = chunks.length > 1 ? ` POOL ${chunkIdx + 1}` : '';
                
                let catParties = [];
                let currentNodes = chunk.map(p => ({ type: 'player', data: p }));

                // Jika hanya 1 orang tersisa
                if (currentNodes.length === 1) {
                    const m = {...INITIAL_STATE.matches[0]};
                    const info = chunk[0];
                    m.cat = info.cat;
                    m.kelas = info.kelas + poolSuffix;
                    m.gender = info.gender;
                    m.maxBabak = info.round || 3;
                    m.maxTimer = info.timer || 120;
                    m.p = tempPIdx++;
                    
                    m.b = info.nama; m.kb = info.kont; m.photoB = info.photo || "";
                    m.m = "BYE"; m.km = "---"; m.photoM = "";
                    m.fase = "FINAL";
                    
                    catParties.push(m);
                }

                // Proses bracket mini (Semi Final / Final)
                while (currentNodes.length > 1) {
                    let nextNodes = [];
                    let matchCount = Math.floor(currentNodes.length / 2);
                    let hasBye = currentNodes.length % 2 !== 0; 

                    for (let i = 0; i < matchCount; i++) {
                        let n1 = currentNodes[i * 2];
                        let n2 = currentNodes[i * 2 + 1];

                        const m = {...INITIAL_STATE.matches[0]};
                        const info = chunk[0];
                        m.cat = info.cat; 
                        m.kelas = info.kelas + poolSuffix;
                        m.gender = info.gender; 
                        m.maxBabak = info.round || 3; 
                        m.maxTimer = info.timer || 120;
                        m.p = tempPIdx++;

                        // Sudut Biru
                        if (n1.type === 'player') {
                            m.b = n1.data.nama; m.kb = n1.data.kont; m.photoB = n1.data.photo || "";
                        } else {
                            let prevMatch = catParties.find(x => x.p === n1.matchId);
                            m.b = "PEMENANG PARTAI " + n1.matchId;
                            m.kb = "---";
                            m.photoB = "";
                            if (prevMatch) prevMatch.nextP = { p: m.p, side: 'biru' };
                        }

                        // Sudut Merah
                        if (n2.type === 'player') {
                            m.m = n2.data.nama; m.km = n2.data.kont; m.photoM = n2.data.photo || "";
                        } else {
                            let prevMatch = catParties.find(x => x.p === n2.matchId);
                            m.m = "PEMENANG PARTAI " + n2.matchId;
                            m.km = "---";
                            m.photoM = "";
                            if (prevMatch) prevMatch.nextP = { p: m.p, side: 'merah' };
                        }
                        
                        catParties.push(m);
                        nextNodes.push({ type: 'match', matchId: m.p });
                    }

                    // Sisipkan oddNode/BYE untuk bertemu pemenang di Final
                    if (hasBye) {
                        let oddNode = currentNodes[currentNodes.length - 1];
                        if (nextNodes.length > 0) {
                            nextNodes.splice(1, 0, oddNode);
                        } else {
                            nextNodes.push(oddNode);
                        }
                    }

                    currentNodes = nextNodes;
                }

                // Penamaan Fase (SEMI FINAL & FINAL)
                if (catParties.length > 0) {
                    let finalMatch = catParties[catParties.length - 1]; 
                    finalMatch.fase = "FINAL";
                    finalMatch.distance = 0;

                    let queue = [finalMatch];
                    while (queue.length > 0) {
                        let curr = queue.shift();
                        
                        let children = catParties.filter(x => x.nextP && x.nextP.p === curr.p);
                        for (let child of children) {
                            child.distance = curr.distance + 1;
                            if (child.distance === 1) child.fase = "SEMI FINAL";
                            
                            queue.push(child);
                        }
                    }
                    catParties.forEach(pt => delete pt.distance);
                }
                
                generatedMatches.push(...catParties);
            });
        }
        
        // 2. GABUNGKAN MATCH LAMA + BARU
        let allMatches = [...existingMatches, ...generatedMatches];
        
        // --- 3. PENJADWALAN BERBASIS JEDA (DEPENDENCY & MIN-GAP SCHEDULER) ---
        // Memastikan atlet setelah Semi Final TIDAK langsung bertanding ke Final tanpa jeda
        let uniquePools = [];
        let poolMatchCount = {};
        
        allMatches.forEach(m => {
            let pKey = `${m.cat}|${m.kelas}|${m.gender}`;
            if (!uniquePools.includes(pKey)) uniquePools.push(pKey);
            poolMatchCount[pKey] = (poolMatchCount[pKey] || 0) + 1;
        });

        uniquePools.sort((a, b) => {
            if (poolMatchCount[b] !== poolMatchCount[a]) return poolMatchCount[b] - poolMatchCount[a];
            return a.localeCompare(b);
        });

        const BATCH_SIZE = 4; 
        const MIN_GAP = 3; // Minimal 3 partai jeda antara Semi Final dan Final (jika ada partai lain tersedia)
        const phaseWeight = { "PENYISIHAN": 1, "PEREMPAT FINAL": 2, "SEMI FINAL": 3, "FINAL": 4 };

        // Hitung prasyarat partai dan index urutan dalam pool
        const prereqsMap = {};
        const sfOrderInPool = {};
        allMatches.forEach((m, idx) => {
            m.originalOrder = idx;
            let pKey = `${m.cat}|${m.kelas}|${m.gender}`;
            let pIndex = uniquePools.indexOf(pKey);
            m.poolIndex = pIndex;
            m.batchId = Math.floor(pIndex / BATCH_SIZE);

            prereqsMap[m.p] = [];
            if (m.fase === "SEMI FINAL") {
                sfOrderInPool[pKey] = (sfOrderInPool[pKey] || 0) + 1;
                m.subOrder = sfOrderInPool[pKey];
            } else {
                m.subOrder = 99;
            }
        });

        allMatches.forEach(m => {
            if (m.nextP && m.nextP.p && prereqsMap[m.nextP.p]) {
                prereqsMap[m.nextP.p].push(m.p);
            }
        });

        const scheduled = [];
        const scheduledPos = {};
        const remaining = [...allMatches];

        while (remaining.length > 0) {
            const currentPos = scheduled.length;
            const eligible = [];

            for (let i = 0; i < remaining.length; i++) {
                const m = remaining[i];
                const prereqs = prereqsMap[m.p] || [];
                const allPrereqsDone = prereqs.every(pid => scheduledPos[pid] !== undefined);
                if (allPrereqsDone) {
                    const lastPrereqIdx = prereqs.length === 0 ? -1 : Math.max(...prereqs.map(pid => scheduledPos[pid]));
                    const gap = prereqs.length === 0 ? 999999 : (currentPos - lastPrereqIdx - 1);
                    eligible.push({ match: m, gap, lastPrereqIdx });
                }
            }

            // Fallback keamanan jika ada referensi partai lama yang hilang
            if (eligible.length === 0) {
                eligible.push({ match: remaining[0], gap: 999999, lastPrereqIdx: -1 });
            }

            // Pilih kandidat yang memenuhi jeda minimal MIN_GAP terlebih dahulu
            const safeEligible = eligible.filter(item => item.gap >= MIN_GAP);
            let chosenItem = null;

            if (safeEligible.length > 0) {
                safeEligible.sort((a, b) => {
                    const mA = a.match, mB = b.match;
                    // 1. Prioritaskan batch lebih awal
                    if (mA.batchId !== mB.batchId) return mA.batchId - mB.batchId;

                    // 2. Prioritaskan fase awal (SEMI FINAL sebelum FINAL)
                    const wA = phaseWeight[mA.fase] || 0;
                    const wB = phaseWeight[mB.fase] || 0;
                    if (wA !== wB) return wA - wB;

                    // 3. Jika sama-sama SEMI FINAL: selang-seling SF1 semua pool lalu SF2 semua pool
                    if (mA.fase === "SEMI FINAL" && mB.fase === "SEMI FINAL") {
                        if (mA.subOrder !== mB.subOrder) return mA.subOrder - mB.subOrder;
                        if (mA.poolIndex !== mB.poolIndex) return mA.poolIndex - mB.poolIndex;
                    }

                    // 4. Jika sama-sama FINAL: dahulukan yang prasyaratnya selesai paling lama (istirahat terlama)
                    if (a.lastPrereqIdx !== b.lastPrereqIdx) return a.lastPrereqIdx - b.lastPrereqIdx;
                    if (mA.poolIndex !== mB.poolIndex) return mA.poolIndex - mB.poolIndex;
                    return mA.originalOrder - mB.originalOrder;
                });
                chosenItem = safeEligible[0];
            } else {
                // Jika tersisa partai dengan jeda < MIN_GAP (menjelang akhir jadwal), ambil yang jedanya PALING BESAR
                eligible.sort((a, b) => {
                    if (b.gap !== a.gap) return b.gap - a.gap;
                    if (a.match.batchId !== b.match.batchId) return a.match.batchId - b.match.batchId;
                    return a.match.originalOrder - b.match.originalOrder;
                });
                chosenItem = eligible[0];
            }

            const chosenMatch = chosenItem.match;
            scheduledPos[chosenMatch.p] = scheduled.length;
            scheduled.push(chosenMatch);
            const remIdx = remaining.indexOf(chosenMatch);
            if (remIdx > -1) remaining.splice(remIdx, 1);
        }

        allMatches = scheduled;

        // Bersihkan variabel temporary
        allMatches.forEach(m => {
            delete m.originalOrder;
            delete m.poolIndex;
            delete m.batchId;
            delete m.subOrder;
        });
        
        // 4. PEMETAAN ULANG PARTAI (P) DARI 1 SAMPAI N
        let pMap = {};
        allMatches.forEach((m, index) => {
            pMap[m.p] = index + 1;
            m.new_p = index + 1;
        });
        
        // Update referensi String dan Objek Partai yang menunjuk pemenang match sebelumnya
        allMatches.forEach(m => {
            if (m.nextP && m.nextP.p) {
                m.nextP.p = pMap[m.nextP.p];
            }
            if (m.b && m.b.startsWith("PEMENANG PARTAI ")) {
                let oldPartai = parseInt(m.b.replace("PEMENANG PARTAI ", ""));
                if(pMap[oldPartai]) m.b = "PEMENANG PARTAI " + pMap[oldPartai];
            }
            if (m.m && m.m.startsWith("PEMENANG PARTAI ")) {
                let oldPartai = parseInt(m.m.replace("PEMENANG PARTAI ", ""));
                if(pMap[oldPartai]) m.m = "PEMENANG PARTAI " + pMap[oldPartai];
            }
            m.p = m.new_p;
            delete m.new_p;
        });
        
        // Inject kembali ke Array Utama 1000 partai
        const updatedMatches = createInitialState().matches;
        for(let i=0; i<updatedMatches.length; i++) {
            if(i < allMatches.length) {
                updatedMatches[i] = allMatches[i];
            } else {
                updatedMatches[i].p = i + 1;
            }
        }
        
        window.state.matches = updatedMatches;
        window.broadcast('matches', updatedMatches);
        alert("Loting Pemasalan Berhasil! Kontingen sama telah dipisahkan dan jeda pertandingan telah diatur secara otomatis. Anda akan dialihkan ke Tab Hasil Loting."); 
        switchLotingPage(3);
    }

